# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicit file types
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.env   text eol=lf

# Windows-specific files should keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files — never convert
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
*.whl   binary

# Docker
Dockerfile        text eol=lf
*.Dockerfile      text eol=lf

# Makefile must use tabs
Makefile          text eol=lf
